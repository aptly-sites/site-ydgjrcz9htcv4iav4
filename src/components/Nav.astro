---
import { site } from '../config';

interface Props {
  // Set to false on any page that isn't "/" — rewrites "#section" nav links to
  // "/#section" so they still resolve, matching the pattern the old
  // rentals.astro used.
  homepage?: boolean;
  activeHref?: string;
}

const { homepage = true, activeHref = '' } = Astro.props;
const linkHref = (href: string) => (!homepage && href.startsWith('#') ? `/${href}` : href);

const NAV_LINKS = [
  { label: 'Property Management', href: '#services' },
  { label: 'Rental Search', href: '/rentals' },
  { label: 'Service Areas', href: '/areas' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];
---

<div class="topbar">
  <div class="container topbar-inner">
    <span>☎ <a href={`tel:${site.phone.replace(/[^\d]/g, '')}`}>{site.phone}</a></span>
    <span>✉ <a href={`mailto:${site.email}`}>{site.email}</a></span>
  </div>
</div>

<nav class="nav" id="nav">
  <div class="container" style="display:flex;align-items:center;justify-content:space-between;height:64px;">
    <a href="/" style="text-decoration:none;display:flex;align-items:center;gap:10px;">
      {site.logoPath
        ? <img src={site.logoPath} alt={site.companyName} style="height:52px;width:auto;object-fit:contain;" />
        : <span style="font-size:18px;font-weight:800;color:var(--color-ink);">{site.companyName}</span>
      }
    </a>
    <div style="display:flex;align-items:center;gap:28px;" class="nav-links">
      {NAV_LINKS.map(link => (
        <a
          href={linkHref(link.href)}
          class="nav-link"
          style={link.href === activeHref ? 'color:var(--color-primary);font-weight:600;' : ''}
        >{link.label}</a>
      ))}
    </div>
    <button id="nav-toggle" style="display:none;background:none;border:none;cursor:pointer;padding:4px;" aria-label="Menu">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>
  <div id="mobile-menu" style="display:none;padding:16px 24px 20px;border-top:1px solid #edf0f5;">
    {NAV_LINKS.map(link => (
      <a href={linkHref(link.href)} class="nav-link" style="display:block;padding:10px 0;">{link.label}</a>
    ))}
  </div>
</nav>

<script>
  const nav = document.getElementById('nav');
  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 20);
  });
  const toggle = document.getElementById('nav-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = mobileMenu?.style.display === 'block';
    if (mobileMenu) mobileMenu.style.display = open ? 'none' : 'block';
  });
  const navLinks = document.querySelector('.nav-links') as HTMLElement;
  const updateNav = () => {
    if (navLinks) navLinks.style.display = window.innerWidth < 800 ? 'none' : 'flex';
    if (toggle) (toggle as HTMLElement).style.display = window.innerWidth < 800 ? 'block' : 'none';
  };
  updateNav();
  window.addEventListener('resize', updateNav);
</script>
