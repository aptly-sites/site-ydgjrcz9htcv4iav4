---
import { site } from '../config';
---

<footer id="contact" style="background:#fff;border-top:1px solid #edf0f5;">
  <div class="container" style="display:grid;grid-template-columns:1.2fr 1fr 1fr auto;gap:50px;padding:64px 24px;align-items:start;">
    <div>
      <h3 style="font-size:16px;margin:0 0 10px;color:var(--color-ink);">{site.companyName}</h3>
      <p style="font-size:14px;color:var(--color-muted);margin:0;">We're a trusted local property management company, always here for owners and ready to assist whenever needed.</p>
    </div>
    <div>
      <h3 style="font-size:16px;margin:0 0 10px;color:var(--color-ink);">Contact</h3>
      <p style="font-size:14px;color:var(--color-muted);margin:0;line-height:1.7;">
        <a href={`tel:${site.phone.replace(/[^\d]/g, '')}`} style="color:var(--color-muted);text-decoration:none;">Phone: {site.phone}</a><br />
        {site.address}
      </p>
    </div>
    <div>
      <h3 style="font-size:16px;margin:0 0 10px;color:var(--color-ink);">Quick Links</h3>
      <p style="font-size:14px;color:var(--color-muted);margin:0;line-height:1.7;">
        <a href="https://jrgrace.owa.rentmanager.com/" target="_blank" rel="noopener noreferrer" style="color:var(--color-muted);text-decoration:none;">Owner Login</a><br />
        <a href="https://jrgrace.twa.rentmanager.com/" target="_blank" rel="noopener noreferrer" style="color:var(--color-muted);text-decoration:none;">Resident Login</a><br />
        <a href={`mailto:${site.email}`} style="color:var(--color-muted);text-decoration:none;">Contact Us</a>
      </p>
    </div>
    <img src="/images/epa.png" alt="EPA Lead-Safe Certified Firm" style="width:130px;object-fit:contain;" />
  </div>
  <p style="text-align:center;font-size:13px;color:var(--color-muted);padding:20px;border-top:1px solid #edf0f5;margin:0;">
    {site.companyName} · {site.address.split(',').slice(-3, -1).map(s => s.trim()).join(', ')}
  </p>
</footer>
