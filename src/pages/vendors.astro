---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site } from '../config';
---

<BaseLayout title={`Vendor Partnerships | ${site.companyName}`} description={`Partner with ${site.companyName} for organized maintenance opportunities, clear communication, and professional property management workflows.`}>
  <Nav homepage={false} activeHref="/vendors" />

  <main class="info-page info-main">
    <section class="info-hero">
      <div class="info-shell">
        <p class="info-eyebrow">Vendor partnerships</p>
        <h1>Quality work deserves an organized partner.</h1>
        <p>{site.companyName} works with dependable maintenance professionals through clear assignments, tracked communication, and consistent standards.</p>
      </div>
    </section>

    <section class="info-section">
      <div class="info-shell">
        <h2>Why vendors work with {site.companyName}.</h2>
        <div class="info-grid three">
          <article class="info-card">
            <h3>Consistent opportunities</h3>
            <p>A large managed portfolio creates recurring needs across repairs, turns, inspections, and property improvements.</p>
          </article>
          <article class="info-card">
            <h3>Clear communication</h3>
            <p>Organized workflows make job scope, scheduling, updates, and completion expectations easier to follow.</p>
          </article>
          <article class="info-card">
            <h3>Long-term relationships</h3>
            <p>Reliable vendors who deliver quality work, transparent pricing, and responsive service become valued partners.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="info-section soft">
      <div class="info-shell info-contact">
        <div>
          <p class="info-eyebrow">What we look for</p>
          <h2>Professionalism from assignment to completion.</h2>
          <ul class="info-list">
            <li>Licensed and insured professionals</li>
            <li>Reliable scheduling</li>
            <li>Clear communication</li>
            <li>High-quality workmanship</li>
            <li>Fair, transparent pricing</li>
            <li>Complete job documentation</li>
          </ul>
        </div>
        <aside class="info-contact-card">
          <p class="info-eyebrow">Become a vendor partner</p>
          <h2>Tell us about your services.</h2>
          <p>Email the team with your company name, service categories, coverage area, insurance information, and best contact details.</p>
          <a href={`mailto:${site.email}?subject=Vendor%20Partnership%20Inquiry`}>{site.email}</a>
          <a href={`tel:${site.phone.replace(/[^\d]/g, '')}`}>{site.phone}</a>
        </aside>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
