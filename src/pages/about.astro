---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site } from '../config';
---

<BaseLayout
  title={`About ${site.companyName} | Waco Property Management`}
  description={`Learn about ${site.companyName}'s experience, professional affiliations, values, and approach to Central Texas property management.`}
>
  <Nav homepage={false} activeHref="/about" />

  <main class="info-page info-main">
    <section class="info-hero">
      <div class="info-shell">
        <p class="info-eyebrow">About {site.companyName}</p>
        <h1>Experienced leadership you can count on.</h1>
        <p>Property management combines everyday service with complicated decisions. Our team brings professional systems, local experience, and genuine care to every managed property.</p>
      </div>
    </section>

    <section class="info-section">
      <div class="info-shell info-contact">
        <div>
          <p class="info-eyebrow">{site.about.headline}</p>
          <h2>{site.about.role}.</h2>
          <p class="info-intro">{site.about.body}</p>
          <div class="info-actions">
            <a class="info-button gold" href="/#analysis">Get a free rental analysis</a>
          </div>
        </div>
        <aside class="info-quote">
          <p class="info-eyebrow">Our purpose</p>
          <h2>Help improve people's lives.</h2>
          <p>We strive to build a reliable, competent organization grounded in integrity, loyalty, due diligence, commitment, and forward-thinking service.</p>
        </aside>
      </div>
    </section>

    <section class="info-section soft">
      <div class="info-shell">
        <p class="info-eyebrow">Professional standards</p>
        <h2>Experience supported by continuing education.</h2>
        <ul class="info-list">
          <li>20+ years of hands-on real estate experience</li>
          <li>Licensed Texas broker</li>
          <li>National Association of Realtors member</li>
          <li>Texas Association of Realtors member</li>
          <li>Waco Association of Realtors member</li>
          <li>NARPM member</li>
          <li>Texas Residential Leasing Specialist</li>
          <li>Texas Residential Property Manager</li>
        </ul>
      </div>
    </section>

    <section class="info-section cream">
      <div class="info-shell">
        <h2>Property management done very well.</h2>
        <div class="info-grid">
          <article class="info-card">
            <h3>Integrity</h3>
            <p>Clear commitments, honest communication, and decisions that respect owners, residents, and partners.</p>
          </article>
          <article class="info-card">
            <h3>Due diligence</h3>
            <p>Documented processes and careful attention to leasing, maintenance, finances, and property condition.</p>
          </article>
          <article class="info-card">
            <h3>Commitment</h3>
            <p>Responsive follow-through and a long-term view of the property, the relationship, and the community.</p>
          </article>
          <article class="info-card">
            <h3>Loyalty</h3>
            <p>A dependable team that protects client interests and treats managed homes with professional care.</p>
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
