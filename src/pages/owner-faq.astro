---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site } from '../config';

const FAQS = [
  { q: 'How soon can you begin managing my property?', a: 'As soon as you are ready, we can prepare a management agreement for electronic signature. Our onboarding specialist will then guide you through the information and documents needed.' },
  { q: 'How much do you charge?', a: 'Our standard management fee is 8% of gross collected rent, with a 50% leasing fee for finding, screening, and placing a resident. Volume discounts may be available.' },
  { q: 'Should I rent out my property or sell it?', a: 'The answer depends on cash flow, equity growth, taxes, financing, and your plans. The calculator above is a useful starting point; our team can help review property-specific considerations.' },
  { q: 'How do you determine rental price?', a: 'We analyze the property, condition, location, and current competing homes to recommend an appropriate rental range.' },
  { q: 'How are maintenance requests handled?', a: 'Residents submit requests through their portal. We determine urgency, troubleshoot, coordinate qualified vendors, and communicate significant issues and costs.' },
  { q: `Can ${site.companyName} help if I decide to sell?`, a: 'Yes. Our licensed real estate professionals can help you evaluate a sale and coordinate the next steps.' },
];
---

<BaseLayout title={`Owner Resources & Rent vs. Sell Calculator | ${site.companyName}`} description={`Compare renting versus selling your property and access ${site.companyName} owner resources and FAQs.`}>
  <Nav homepage={false} activeHref="/owner-faq" />

  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">A clearer path for your property</p>
      <h1>Should you rent it—or sell it?</h1>
      <p class="lead">Compare the estimated long-term wealth from keeping your home as a rental with selling today. Adjust every assumption to reflect your property and plans.</p>

      <div class="calculator">
        <div class="calculator-head">
          <div>
            <p class="eyebrow">Rent vs. sell calculator</p>
            <h2>See both paths side by side</h2>
          </div>
          <p>Results update instantly as you change your assumptions.</p>
        </div>
        <div class="calculator-grid">
          <form id="calculator-form">
            <fieldset>
              <legend>Property and financing</legend>
              <label>Current home value <span>$<input name="homeValue" type="number" min="0" step="1000" value="325000" /></span></label>
              <label>Mortgage balance <span>$<input name="mortgageBalance" type="number" min="0" step="1000" value="210000" /></span></label>
              <label>Monthly mortgage payment <span>$<input name="monthlyMortgagePayment" type="number" min="0" step="25" value="1450" /></span></label>
              <label>Monthly taxes &amp; insurance <span>$<input name="monthlyTaxesInsurance" type="number" min="0" step="25" value="725" /></span></label>
            </fieldset>
            <fieldset>
              <legend>Rental assumptions</legend>
              <label>Expected monthly rent <span>$<input name="monthlyRent" type="number" min="0" step="25" value="2400" /></span></label>
              <label>Initial make-ready cost <span>$<input name="makeReadyCosts" type="number" min="0" step="250" value="3500" /></span></label>
              <label>Annual maintenance <span>$<input name="annualMaintenanceCosts" type="number" min="0" step="250" value="4000" /></span></label>
              <label>Vacancy rate <span><input name="vacancyRate" type="number" min="0" max="100" step=".5" value="5" />%</span></label>
            </fieldset>
            <fieldset>
              <legend>Growth assumptions</legend>
              <label>Annual appreciation <span><input name="appreciationRate" type="number" min="-20" max="30" step=".5" value="3" />%</span></label>
              <label>Annual rent growth <span><input name="rentGrowthRate" type="number" min="-20" max="30" step=".5" value="3" />%</span></label>
              <label>Selling costs <span><input name="sellingCosts" type="number" min="0" max="30" step=".5" value="6" />%</span></label>
              <label>Sale-proceeds return <span><input name="investmentReturn" type="number" min="-20" max="30" step=".5" value="6" />%</span></label>
            </fieldset>
          </form>
          <section class="results" aria-live="polite">
            <label class="years">Comparison period: <strong><b id="years-label">5</b> years</strong>
              <input id="yearsToHold" type="range" min="1" max="15" value="5" />
              <small><i>1 year</i><i>15 years</i></small>
            </label>
            <div class="recommendation">
              <small>Estimated stronger path</small>
              <strong id="recommendation-title"></strong>
              <p id="recommendation-copy"></p>
            </div>
            <div class="cards">
              <article><span>Rent-out wealth</span><strong id="rent-wealth"></strong><small>Equity plus cumulative cash flow</small></article>
              <article><span>Sell-now wealth</span><strong id="sell-wealth"></strong><small>Net proceeds invested over time</small></article>
              <article id="difference-card"><span>Estimated difference</span><strong id="wealth-difference"></strong><small id="difference-context"></small></article>
            </div>
            <div id="wealth-chart" class="chart" role="img" aria-label="Projected wealth comparison by year"></div>
            <details>
              <summary>View year-by-year breakdown</summary>
              <div class="scroll">
                <table>
                  <thead><tr><th>Year</th><th>Rental income</th><th>Net cash flow</th><th>Home value</th><th>Rent wealth</th><th>Sell wealth</th></tr></thead>
                  <tbody id="breakdown-body"></tbody>
                </table>
              </div>
            </details>
            <p class="note">Educational estimate only. It excludes income and capital-gains taxes, depreciation recapture, management fees, major capital expenses, and transaction-specific advice. Consult qualified real estate, tax, and financial professionals before deciding.</p>
          </section>
        </div>
        <div class="resources">
          <a href="https://jrgrace.owa.rentmanager.com/" target="_blank" rel="noopener noreferrer"><strong>Owner Portal</strong><span>Statements, documents and account access →</span></a>
          <a href={`mailto:${site.email}`}><strong>Request Form W-9</strong><span>Email us for the current tax form →</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="faq">
    <p class="eyebrow">Owner resources</p>
    <h2>Frequently asked owner questions</h2>
    <p>Practical answers from a team that manages homes across Central Texas.</p>
    <div class="faq-list">
      {FAQS.map(f => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  const form = document.querySelector('#calculator-form') as HTMLFormElement;
  const y = document.querySelector('#yearsToHold') as HTMLInputElement;
  const fmt = (v: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(Math.round(v));
  const n = (k: string) => Number((form.elements.namedItem(k) as HTMLInputElement)?.value || 0);

  function calc() {
    const x = {
      home: n('homeValue'), balance: n('mortgageBalance'), payment: n('monthlyMortgagePayment'), tax: n('monthlyTaxesInsurance'),
      rent: n('monthlyRent'), ready: n('makeReadyCosts'), maint: n('annualMaintenanceCosts'), vac: n('vacancyRate'),
      app: n('appreciationRate'), growth: n('rentGrowthRate'), sell: n('sellingCosts'), ret: n('investmentReturn'), years: Number(y.value),
    };
    const proceeds = Math.max(0, x.home * (1 - x.sell / 100) - x.balance);
    const rows: any[] = [];
    let cash = -x.ready;
    for (let i = 1; i <= x.years; i++) {
      const home = x.home * (1 + x.app / 100) ** i;
      const income = x.rent * 12 * (1 + x.growth / 100) ** (i - 1) * (1 - x.vac / 100);
      const net = income - x.payment * 12 - x.tax * 12 - x.maint * 1.03 ** (i - 1);
      cash += net;
      const rentWealth = home - Math.max(0, x.balance * 0.95 ** i) + cash;
      const sellWealth = proceeds * (1 + x.ret / 100) ** i;
      rows.push({ i, income, net, home, rentWealth, sellWealth, diff: rentWealth - sellWealth });
    }
    return rows;
  }

  function render() {
    const rows = calc();
    const z = rows.at(-1);
    const rent = z.diff >= 0;
    const d = Math.abs(z.diff);
    const max = Math.max(1, ...rows.flatMap(r => [r.rentWealth, r.sellWealth]));
    document.querySelector('#years-label')!.textContent = y.value;
    document.querySelector('#rent-wealth')!.textContent = fmt(z.rentWealth);
    document.querySelector('#sell-wealth')!.textContent = fmt(z.sellWealth);
    document.querySelector('#wealth-difference')!.textContent = (z.diff < 0 ? '−' : '') + fmt(d);
    document.querySelector('#difference-context')!.textContent = `in favor of ${rent ? 'renting' : 'selling'} after ${y.value} year${y.value === '1' ? '' : 's'}`;
    document.querySelector('#recommendation-title')!.textContent = rent ? 'Renting projects more wealth' : 'Selling projects more wealth';
    document.querySelector('#recommendation-copy')!.textContent = `Based on these assumptions, ${rent ? 'keeping the home as a rental' : 'selling and investing the net proceeds'} is ahead by about ${fmt(d)}.`;
    document.querySelector('#wealth-chart')!.innerHTML = rows.map(r => `<div class="chart-year" title="Year ${r.i}: Rent ${fmt(r.rentWealth)}, Sell ${fmt(r.sellWealth)}"><i class="bar rent" style="height:${Math.max(2, r.rentWealth / max * 100)}%"></i><i class="bar sell" style="height:${Math.max(2, r.sellWealth / max * 100)}%"></i><small>${r.i}</small></div>`).join('');
    document.querySelector('#breakdown-body')!.innerHTML = rows.map(r => `<tr><td>${r.i}</td><td>${fmt(r.income)}</td><td>${fmt(r.net)}</td><td>${fmt(r.home)}</td><td>${fmt(r.rentWealth)}</td><td>${fmt(r.sellWealth)}</td></tr>`).join('');
  }

  form?.addEventListener('input', render);
  y?.addEventListener('input', render);
  render();
</script>

<style>
  :root {
    --owner-navy: #12263d;
    --owner-gold: #c5a85f;
    --owner-cream: #f5f2eb;
    --owner-line: #d8dde4;
    --owner-orange: #f26a2e;
  }
  .hero { padding: 72px 22px 62px; background: linear-gradient(180deg, var(--owner-navy) 0 39%, #eef2f6 39%); }
  .wrap { max-width: 1400px; margin: auto; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.14em; font-size: 12px; font-weight: 800; color: var(--owner-gold); margin: 0 0 13px; }
  .hero h1 { font: 700 clamp(36px, 6vw, 68px) / 1.02 Georgia, serif; color: #fff; letter-spacing: -0.03em; max-width: 900px; margin: 0; }
  .lead { font-size: 18px; line-height: 1.55; color: #e4ebf4; max-width: 780px; margin: 24px 0 40px; }

  .calculator { background: #fff; box-shadow: 0 24px 60px rgba(7, 26, 48, 0.18); border-radius: 4px; overflow: hidden; }
  .calculator-head { display: flex; align-items: flex-end; justify-content: space-between; padding: 30px 38px; border-bottom: 1px solid var(--owner-line); flex-wrap: wrap; gap: 16px; }
  .calculator-head h2 { font: 700 30px Georgia, serif; margin: 0; color: var(--owner-navy); }
  .calculator-head > p { max-width: 300px; color: #657285; margin: 0; }
  .calculator-grid { display: grid; grid-template-columns: minmax(300px, 0.86fr) minmax(400px, 1.3fr); }
  form { padding: 30px 38px; background: var(--owner-cream); border-right: 1px solid var(--owner-line); }
  fieldset { border: 0; margin: 0 0 25px; padding: 0; }
  legend { font-weight: 800; margin-bottom: 13px; color: var(--owner-navy); }
  form label { display: grid; grid-template-columns: 1fr 130px; align-items: center; gap: 12px; margin: 9px 0; font-size: 14px; color: #435064; }
  form label span { display: flex; align-items: center; background: #fff; border: 1px solid #cbd2da; padding-left: 10px; color: #778494; }
  input[type='number'] { width: 100%; border: 0; padding: 10px; background: transparent; text-align: right; font-weight: 700; color: #152237; outline: none; }
  .results { padding: 32px 38px; }
  .years { display: block; font-size: 14px; color: #435064; }
  .years input { display: block; width: 100%; accent-color: var(--color-primary); margin-top: 13px; }
  .years small { display: flex; justify-content: space-between; color: #758194; }
  .recommendation { margin: 26px 0; padding: 23px; border-left: 5px solid var(--owner-gold); background: var(--owner-navy); color: #fff; }
  .recommendation small { text-transform: uppercase; letter-spacing: 0.1em; color: #ddce9d; }
  .recommendation strong { display: block; font: 700 26px Georgia, serif; margin: 6px 0; }
  .recommendation p { margin: 0; color: #dce5ee; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--owner-line); }
  .cards article { padding: 19px; border-right: 1px solid var(--owner-line); }
  .cards article:last-child { border-right: 0; }
  .cards span, .cards small { display: block; }
  .cards span { text-transform: uppercase; letter-spacing: 0.1em; font-size: 10px; font-weight: 800; color: #6e7988; }
  .cards strong { display: block; font: 700 clamp(20px, 2.3vw, 30px) Georgia, serif; color: var(--color-primary); margin: 7px 0; }
  .cards small { color: #758194; }
  .chart { height: 200px; display: flex; align-items: flex-end; gap: 7px; padding: 28px 7px 24px; border-bottom: 1px solid var(--owner-line); }
  .chart-year { flex: 1; height: 100%; display: flex; align-items: flex-end; justify-content: center; gap: 2px; position: relative; }
  .bar { width: min(16px, 44%); min-height: 2px; border-radius: 3px 3px 0 0; }
  .rent { background: var(--color-primary); }
  .sell { background: var(--owner-orange); }
  .chart-year small { position: absolute; bottom: -18px; font-size: 9px; color: #788494; }
  .results details { margin-top: 20px; border: 1px solid var(--owner-line); }
  summary { cursor: pointer; font-weight: 800; padding: 16px; }
  .scroll { overflow: auto; padding: 0 15px 15px; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  th, td { text-align: right; padding: 9px; border-bottom: 1px solid #e5e8ec; white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  .note { font-size: 11px; line-height: 1.55; color: #768293; padding: 0 38px 30px; margin: 0; }
  .resources { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; padding: 0 38px 38px; }
  .resources a { display: flex; justify-content: space-between; gap: 20px; padding: 24px 27px; background: #fff; border: 1px solid var(--owner-line); border-top: 4px solid var(--owner-gold); color: var(--owner-navy); text-decoration: none; }
  .resources strong { font: 700 20px Georgia, serif; }
  .resources span { color: #657285; }

  .faq { max-width: 1050px; margin: auto; padding: 90px 22px; text-align: center; }
  .faq h2 { font: 700 clamp(32px, 5vw, 48px) Georgia, serif; color: var(--owner-navy); margin: 0; }
  .faq > p:last-of-type { font-size: 17px; color: #657285; }
  .faq-list { text-align: left; border-top: 1px solid var(--owner-line); margin-top: 35px; }
  .faq-list details { border-bottom: 1px solid var(--owner-line); }
  .faq-list summary { font: 700 18px Georgia, serif; color: var(--owner-navy); padding: 23px 0; }
  .faq-list details p { line-height: 1.7; color: #526175; margin: 0 0 24px; }

  @media (max-width: 1000px) {
    .calculator-grid { grid-template-columns: 1fr; }
    form { border-right: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .cards { grid-template-columns: 1fr; }
    .cards article { border-right: 0; border-bottom: 1px solid var(--owner-line); }
    .resources { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    form { display: block; }
  }
</style>
