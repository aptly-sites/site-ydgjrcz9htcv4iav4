---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site } from '../config';

const city = site.address.split(',')[1]?.trim() || 'your area';

const TASKS = [
  { task: 'Marketing', diy: 'Owner photography, listing copy, inquiries, showings, and risk of pricing above or below current demand.', jrg: `Market preparation, professional presentation, listing distribution, inquiry handling, and tour coordination.` },
  { task: 'Resident screening', diy: 'Application tools, verification time, fair-housing consistency, and risk from incomplete rental or income history.', jrg: 'A consistent bundled process covering credit, rental history, income, and nationwide eviction history.' },
  { task: 'Rent collection', diy: 'Payment setup, reminders, documentation, late-payment follow-up, and difficult resident conversations.', jrg: 'Online resident payments, monitoring, clear expectations, and a consistent collection process.' },
  { task: 'Maintenance', diy: 'After-hours calls, vendor sourcing, bid comparison, scheduling, quality control, and invoice review.', jrg: 'In-house maintenance and coordinated work with owner communication.' },
  { task: 'Evictions', diy: 'Notice errors, filing time, court coordination, lost rent, and legal exposure.', jrg: 'Documented lease enforcement and coordination with legal support when necessary.' },
  { task: 'Legal compliance', diy: 'Owner must track fair housing, notices, deposits, habitability, documentation, and changing requirements.', jrg: 'Repeatable processes and professional oversight; legal counsel is coordinated when required.' },
];

const FAQS = [
  { q: `Is a property manager worth it in ${city}?`, a: 'A property manager can be worth it when professional pricing, faster leasing, consistent screening, maintenance coordination, documentation, and compliance reduce vacancy, mistakes, or owner time by more than the management cost.' },
  { q: 'What percentage do property managers charge in Texas?', a: 'Texas property management fees vary by company, property, and service package. Owners should compare the monthly fee together with leasing, renewal, maintenance-coordination, inspection, and termination charges rather than relying on one percentage.' },
];
---

<BaseLayout
  title={`Self Managing vs Hiring a Property Manager in ${city} | Cost Breakdown`}
  description={`A practical cost comparison between self-managing a ${city} rental property and hiring a professional property manager.`}
>
  <Nav homepage={false} />

  <main class="article-page">
    <section class="article-hero">
      <div class="container">
        <p class="eyebrow">{city.toUpperCase()} RENTAL OWNER GUIDE</p>
        <h1>Self Managing vs Hiring a Property Manager in {city}: A Cost Breakdown</h1>
        <p>Professional management adds a visible recurring cost. Self-management replaces that fee with owner time and less predictable exposure to vacancy days, mispriced rent, screening mistakes, maintenance coordination, documentation gaps, and eviction or compliance errors. The lower-cost choice depends on how effectively an owner can perform each task.</p>
      </div>
    </section>

    <article class="container article-body">
      <h2>Task-by-task comparison</h2>
      <table class="comparison-table">
        <thead><tr><th>Task</th><th>DIY cost or risk</th><th>With {site.companyName}</th></tr></thead>
        <tbody>
          {TASKS.map(t => (
            <tr><td>{t.task}</td><td>{t.diy}</td><td>{t.jrg}</td></tr>
          ))}
        </tbody>
      </table>

      <section class="worked-example">
        <h2>Worked example: a $1,800 per month rental</h2>
        <p>Consider a home advertised at $1,800 per month. One week of avoidable vacancy represents about <strong>$414</strong> in missed rent. Pricing the home just $100 below market costs <strong>$1,200 over a year</strong>. A hypothetical 10% management fee would equal <strong>$180 per month</strong>, before any leasing or optional-service charges. This example does not represent a {site.companyName} quote; it shows why owners should compare the full proposal against vacancy, pricing accuracy, time, and risk—not the monthly percentage alone.</p>
      </section>

      <section class="article-faq">
        <h2>Frequently asked questions</h2>
        {FAQS.map(f => (
          <article>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </article>
        ))}
      </section>

      <div class="city-actions">
        <a class="btn-primary" href="/#analysis">Get a free rental analysis</a>
        <a class="btn-ghost" href="/">Return to {site.companyName}</a>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article-hero { padding: 70px 24px; background: #0d1e32; color: #fff; }
  .article-hero .eyebrow { text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.75rem; font-weight: 800; color: #cfbb80; margin: 0 0 14px; }
  .article-hero h1 { font-size: clamp(2rem, 5vw, 3.4rem); max-width: 900px; color: #fff; margin: 0 0 18px; }
  .article-hero p { font-size: 1.05rem; max-width: 800px; color: #c7d1dc; margin: 0; }

  .article-body { padding: 60px 24px; max-width: 940px; }
  .article-body h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); color: var(--color-primary); margin: 40px 0 18px; }
  .article-body h2:first-child { margin-top: 0; }

  .comparison-table { width: 100%; border-collapse: collapse; margin: 24px 0 40px; font-size: 0.92rem; }
  .comparison-table th, .comparison-table td { padding: 14px; text-align: left; border: 1px solid #d7dce3; vertical-align: top; }
  .comparison-table th { background: var(--color-primary); color: #fff; }
  .comparison-table td { color: var(--color-ink); }

  .worked-example { background: #f3f1ec; padding: 30px; border-left: 5px solid #b7a064; margin-bottom: 20px; }
  .worked-example p { color: var(--color-ink); line-height: 1.7; margin: 0; }

  .article-faq article { padding: 20px 0; border-top: 1px solid #d7dce3; }
  .article-faq h3 { font-size: 1.05rem; color: var(--color-primary); margin: 0 0 8px; }
  .article-faq p { margin: 0; color: var(--color-muted); line-height: 1.6; }

  .city-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 36px; }

  @media (max-width: 700px) {
    .comparison-table { display: block; overflow-x: auto; }
  }
</style>
