---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site } from '../config';

const addressParts = site.address.split(',').map(p => p.trim());
const addressCity = addressParts[1] || '';
const addressState = addressParts[2] || '';

const FAQS = [
  { q: 'How much does property management cost in Waco, TX?', a: 'Property management pricing depends on the property and services selected. J R Grace Realty provides a clear management proposal after reviewing the home; the optional Owner Benefit Package is $45 per month per unit.' },
  { q: 'What services does J R Grace Realty provide?', a: 'J R Grace Realty provides marketing and advertising, tenant screening, lease preparation and enforcement, rent collection, in-house maintenance, inspections, eviction coordination, and financial reporting for Waco-area rental owners.' },
  { q: 'How do you screen tenants?', a: 'Every applicant goes through a bundled screening package that includes credit evaluation, rental history verification, income verification, and a nationwide eviction history check.' },
  { q: 'How long does it take to rent out my property in Waco?', a: 'Leasing time depends on pricing, condition, season, and demand. J R Grace Realty markets homes on its website, syndicates listings to major rental sites, and uses professional presentation to reduce avoidable vacancy.' },
  { q: 'Do you handle evictions?', a: 'Yes. J R Grace Realty coordinates the eviction process when necessary and maintains an attorney relationship for legal support. Thorough screening and consistent rent collection are designed to make evictions rare.' },
  { q: 'Who handles maintenance and repairs?', a: 'J R Grace Realty has an in-house maintenance team and coordinates work as the general contractor. Residents submit requests through an online portal, and owners receive communication about work performed.' },
  { q: 'What areas do you serve?', a: 'J R Grace Realty manages rental properties throughout Central Texas, including Waco, Woodway, Hewitt, Robinson, China Spring, Bellmead, and Lacy Lakeview.' },
  { q: 'How do I get started?', a: `Start with a free rental analysis to understand likely rent, opportunities to improve performance, and whether the property fits J R Grace Realty's services. Call ${site.phone} or complete the form on this page.` },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout>
  <Nav />

  <!-- HERO -->
  <section class="hero">
    <video autoplay muted loop playsinline preload="auto" poster="/images/waco-poster.jpg" aria-hidden="true">
      <source src="/images/waco-web.mp4" type="video/mp4" />
    </video>
    <div class="shade"></div>
    <div class="hero-copy">
      <img class="reviews" src="/images/reviews.png" alt={`${site.companyName} — 4.5 stars, 468+ reviews`} />
      <h1>{site.hero.headline}</h1>
      <p>{site.tagline}</p>
      <div class="associations">
        <img src="/images/narpm.webp" alt="NARPM" />
        <img src="/images/waor.png" alt="Waco Association of Realtors" />
      </div>
    </div>
  </section>

  <!-- ENTITY ANSWER -->
  <section class="entity-answer">
    <div class="container">
      <h2>{addressCity}, {addressState} Property Management by {site.companyName}</h2>
      <p>
        {site.description} Our office is located at {site.address}. Call <a href={`tel:${site.phone.replace(/[^\d]/g, '')}`}>{site.phone}</a> for a free rental analysis.
      </p>
    </div>
  </section>

  <!-- CHOICE -->
  <section class="choice container">
    <article class="floating-card">
      <h3>Your choice for Waco<br />Property Management</h3>
      <p>We specialize in full service property management services to fit your needs as a landlord or home owner. We tailor our services to ensure that you have the highest level of service for your home. We treat your home as our own.</p>
      <a class="btn-primary" href="#analysis">{site.hero.cta}</a>
    </article>
    <article class="floating-card">
      <h3>Interested in a rental?<br />Apply Now!</h3>
      <p>To set up a showing for any of our properties call <strong>{site.phone}</strong>. Whether you are looking for a single family home, townhouse or condo, we will have one of our dedicated team members work with you.</p>
      <a class="btn-primary" href="/rentals">View Available Properties</a>
    </article>
  </section>

  <!-- LEADERSHIP -->
  <section class="leadership">
    <div class="container leadership-grid">
      <div class="leadership-copy">
        <h2>{site.about.headline}</h2>
        <p class="role">{site.about.role}</p>
        <p>{site.about.body}</p>
        <p>{site.about.body2}</p>
        <a class="btn-primary leadership-cta" href="#analysis">{site.hero.cta}</a>
      </div>
      <div class="portrait-panel">
        <img src="/images/portrait.png" alt={`${site.about.headline}, ${site.companyName} Owner and Broker`} />
      </div>
    </div>
  </section>

  <!-- CONNECTED -->
  <section class="connected">
    <div class="container center">
      <h2>Connected Property Management</h2>
      <div class="connection-grid">
        <article class="connection-card owners">
          <img src="/images/mark.png" alt="" />
          <h3>Owners /<br />Prospective<br />Owners</h3>
          <span class="rule"></span>
          <p>We help owners protect and grow their investments through professional management, clear communication, and transparent reporting.</p>
        </article>
        <article class="connection-card residents">
          <img src="/images/mark.png" alt="" />
          <h3>Residents /<br />Prospective<br />Residents</h3>
          <span class="rule"></span>
          <p>We provide residents with a simple, stress-free rental experience from leasing through daily living. With responsive support and clear communication, we make it easy to feel at home.</p>
        </article>
        <article class="connection-card realtors">
          <img src="/images/mark.png" alt="" />
          <h3>Realtors / Referral<br />Partners</h3>
          <span class="rule"></span>
          <p>We partner with realtors to ensure smooth transactions and positive outcomes for their clients. Our focus is on reliability, communication, and long-term trust.</p>
        </article>
        <article class="connection-card vendors">
          <img src="/images/mark.png" alt="" />
          <h3>Vendors</h3>
          <span class="rule"></span>
          <p>We work with vendors through clear communication, organized workflows, and consistent job opportunities. Our process is designed to keep work efficient and coordination simple.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- TRUSTED / STATS -->
  <section class="trusted">
    <div class="container center">
      <h2>Trusted by {site.address.split(',')[1]?.trim() || 'Waco'}, Texas</h2>
      <p class="intro">Managing a successful rental property requires time, experience, and ongoing attention. {site.companyName} takes that responsibility off your plate, saving you time and eliminating the stress that comes with managing a rental on your own while protecting and growing your investment.</p>
      <div class="stats">
        {site.stats.map(stat => (
          <div>
            <strong>{stat.value.replace(/\+$/, '')}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MANAGE / SERVICES -->
  <section id="services" class="manage">
    <div class="container">
      <h2 class="center">How We'll Manage<br />Your {site.address.split(',')[1]?.trim() || 'Waco'}, Texas Rental Property</h2>
      <div class="service-answer-grid">
        {site.services.map(service => (
          <article>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DIFFERENCE -->
  <section class="difference">
    <div class="container center">
      <h2>What Makes {site.companyName} the Best Choice?</h2>
      <p class="intro">Our team understands that the details matter. From financial accuracy to regulatory compliance, we take a precise and thorough approach to property management. Our commitment to accuracy and compliance is what truly sets us apart.</p>
      <div class="feature-grid">
        <article>
          <div class="feature-photo"><img src="/images/features/personalized-service.jpg" alt="A property manager speaking with a homeowner at a rental property" loading="lazy" /></div>
          <div class="feature-copy">
            <h3>Personalized Service</h3>
            <p>We are a technology-forward company that leverages AI to streamline operations and maintain a consistent, reliable cadence of communication with our clients.</p>
          </div>
        </article>
        <article>
          <div class="feature-photo"><img src="/images/features/experienced-professionals.jpg" alt="Experienced real estate professionals walking through a rental home" loading="lazy" /></div>
          <div class="feature-copy">
            <h3>Experienced Professionals</h3>
            <p>Over 20 years of hands-on experience in building, flipping, rehabbing, wholesaling, and owner financing gives us a well-rounded understanding of the full real estate lifecycle.</p>
          </div>
        </article>
        <article>
          <div class="feature-photo"><img src="/images/features/efficient-systems.jpg" alt="A property management professional reviewing organized operational reports" loading="lazy" /></div>
          <div class="feature-copy">
            <h3>Efficient, Proven Systems</h3>
            <p>Modern technology streamlines operations and communication, automates routine tasks, and creates an efficient, hassle-free experience.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="happy center"><h2>We Love When Our Clients Are Happy</h2></section>

  <!-- ANALYSIS / CONTACT FORM -->
  <section id="analysis" class="rent-estimate">
    <div class="container">
      <div class="analysis-heading">
        <p class="analysis-kicker">Free local rental analysis</p>
        <h2>Get Your FREE Property Management Rental Analysis</h2>
        <p>Tell us about your property and receive a personalized rent recommendation from the {site.companyName} team.</p>
      </div>
      <div class="estimate-shell">
        <form id="contact-form">
          <div class="form-section">
            <div class="form-section-heading">
              <span>01</span>
              <div><h3>Tell us about the property</h3><p>Start with the details that shape its rental value.</p></div>
            </div>
            <div class="field-grid">
              <label class="field field-wide">
                <span>Property address</span>
                <input required autocomplete="street-address" name="address" placeholder="Paste the full address, including city, state, and ZIP" maxlength="280" />
                <small class="address-validation">Enter a complete street address.</small>
              </label>
              <label class="field">
                <span>Property type</span>
                <select required name="propertyType">
                  <option value="" selected disabled>Select property type</option>
                  <option>Single-family home</option>
                  <option>Townhome</option>
                  <option>Condo</option>
                  <option>Duplex</option>
                  <option>Multifamily property</option>
                  <option>Other</option>
                </select>
              </label>
              <label class="field">
                <span>Bedrooms</span>
                <select required name="bedrooms">
                  <option value="" selected disabled>Select bedrooms</option>
                  <option>Studio</option>
                  <option>1</option>
                  <option>2</option>
                  <option>3</option>
                  <option>4</option>
                  <option>5+</option>
                </select>
              </label>
              <label class="field">
                <span>Bathrooms</span>
                <select required name="bathrooms">
                  <option value="" selected disabled>Select bathrooms</option>
                  <option>1</option>
                  <option>1.5</option>
                  <option>2</option>
                  <option>2.5</option>
                  <option>3</option>
                  <option>3.5</option>
                  <option>4+</option>
                </select>
              </label>
            </div>
          </div>

          <div class="form-section">
            <div class="form-section-heading">
              <span>02</span>
              <div><h3>What would you like to accomplish?</h3><p>We'll tailor the analysis to your goals.</p></div>
            </div>
            <label class="field">
              <span>Primary goal</span>
              <select required name="goal">
                <option value="" selected disabled>Select your primary goal</option>
                <option>Determine how much my property could rent for</option>
                <option>Hire a professional property manager</option>
                <option>Reduce vacancy and improve performance</option>
                <option>Prepare a property for the rental market</option>
                <option>Compare renting the property versus selling</option>
                <option>Plan for a future investment property</option>
              </select>
            </label>
            <label class="field" style="margin-top:19px;">
              <span>Anything else we should know? <em>Optional</em></span>
              <textarea name="message" placeholder="Share recent upgrades, timing, current occupancy, or questions for our team." maxlength="2000"></textarea>
            </label>
          </div>

          <div class="form-section contact-section">
            <div class="form-section-heading">
              <span>03</span>
              <div><h3>Where should we send your analysis?</h3><p>Your information stays with {site.companyName}.</p></div>
            </div>
            <div class="field-grid">
              <label class="field">
                <span>Full name</span>
                <input required autocomplete="name" name="name" placeholder="Your full name" maxlength="100" />
              </label>
              <label class="field">
                <span>Email address</span>
                <input required autocomplete="email" type="email" name="email" placeholder="you@example.com" maxlength="160" />
              </label>
              <label class="field">
                <span>Phone number</span>
                <input required autocomplete="tel" type="tel" name="phone" placeholder={site.phone} maxlength="30" />
              </label>
            </div>
            <label class="privacy">
              <input type="checkbox" name="smsConsent" value="yes" required />
              <span>By providing your phone number, you agree to receive recurring SMS messages from {site.companyName}. Message and data rates may apply. Reply STOP to opt out.</span>
            </label>
            <button type="submit"><span>Request My Free Rental Analysis</span><b aria-hidden="true">→</b></button>
            <p id="form-success" class="form-note" style="display:none;">✓ Sent! We'll be in touch within 24 hours.</p>
          </div>
        </form>

        <aside class="estimate-aside">
          <p class="analysis-kicker">What you'll receive</p>
          <h3>A local, property-specific rental review.</h3>
          <ol>
            <li><span>01</span><div><strong>Rental value range</strong><p>A recommended range based on the home, location, and current competition.</p></div></li>
            <li><span>02</span><div><strong>Market positioning</strong><p>Practical ways to improve presentation, leasing velocity, and long-term performance.</p></div></li>
            <li><span>03</span><div><strong>Management fit</strong><p>A straightforward assessment of how {site.companyName} can support your goals.</p></div></li>
          </ol>
          <div class="service-area-note">
            <strong>Serving {site.areas.length ? site.areas[0].name : 'the area'}</strong>
            <p>{site.areas.map(a => a.name).join(' · ') || 'Contact us to confirm your service area.'}</p>
          </div>
          <small>Estimates are informational and may vary with market conditions, property condition, upgrades, seasonality, and other factors. This service is non-binding.</small>
        </aside>
      </div>
    </div>
  </section>

  <!-- BENEFIT CARDS -->
  <section class="benefit-cards">
    <div class="container center">
      <h2>Discover How {site.companyName} Can Benefit You</h2>
      <div class="card-grid">
        <article>
          <img src="/images/expert.jpg" alt={`${site.address.split(',')[1]?.trim() || 'Waco'} rental property`} />
          <h3>Expert Insights</h3>
          <p>With over 20 years of hands-on experience in {site.address.split(',')[1]?.trim() || 'Waco'}, we know what it takes to keep rentals performing.</p>
        </article>
        <article>
          <img src="/images/systems.jpg" alt={`${site.address.split(',')[1]?.trim() || 'Waco'} home`} />
          <h3>Smart Systems</h3>
          <p>Our modern management platform handles rent collection, maintenance requests, and reporting.</p>
        </article>
        <article>
          <img src="/images/stress.jpg" alt={`${site.address.split(',')[1]?.trim() || 'Waco'} rental home`} />
          <h3>Stress Less,<br />Earn More</h3>
          <p>We take care of the day-to-day details so you can enjoy steady cash flow and peace of mind.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- COMPARISON LINK -->
  <section class="comparison-link">
    <div class="container">
      <p class="eyebrow">Owner resource</p>
      <h2>Self-managing or hiring a {site.address.split(',')[1]?.trim() || 'local'} property manager?</h2>
      <p>Compare the direct fees with the hidden costs of vacancy, screening mistakes, maintenance coordination, and compliance.</p>
      <a class="btn-accent" href="/self-managing-vs-hiring">See the cost breakdown</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section" id="faq">
    <div class="container">
      <h2>Frequently Asked Questions About Property Management in {site.address.split(',')[1]?.trim() || 'Waco'}</h2>
      <div class="faq-grid">
        {FAQS.map(f => (
          <article>
            <h3>{f.q}</h3>
            <p set:html={f.a.replace(new RegExp(site.phone.replace(/[^\d]/g, ''), 'g'), site.phone)} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- AREAS BAND -->
  <section class="areas-band center">
    <div class="shade"></div>
    <div>
      <h2>Areas We Serve</h2>
      <p>
        {site.areas.map((area, i) => (
          <>
            {i > 0 && ' · '}
            <a href={`/areas/${area.slug}`}>{area.name}</a>
          </>
        ))}
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form));
    console.log('Form submission:', data);
    form.style.display = 'none';
    if (success) success.style.display = 'block';
  });
</script>

<style>
  .hero { height: 590px; position: relative; overflow: hidden; color: #fff; }
  .hero video { position: absolute; width: 100%; height: 100%; object-fit: cover; top: 0; left: 0; }
  .hero .shade { position: absolute; inset: 0; background: linear-gradient(#10213d77, #10213dbb); }
  .hero-copy { position: relative; z-index: 1; text-align: center; padding-top: 96px; }
  .hero-copy .reviews { display: inline-block; width: 190px; filter: drop-shadow(0 2px 3px rgba(0,0,0,0.5)); }
  .hero-copy h1 { font-size: clamp(2.4rem, 5vw, 4.5rem); margin: 20px 0 5px; color: #fff; }
  .hero-copy p { font-size: clamp(1.2rem, 2.4vw, 2rem); margin: 0; }
  .associations { display: flex; justify-content: center; align-items: center; gap: 25px; margin-top: 18px; }
  .associations img { max-width: 150px; max-height: 68px; object-fit: contain; }

  .entity-answer { padding: 58px 24px 155px; background: #f7f8fa; border-bottom: 1px solid #e1e5ec; }
  .entity-answer .container { max-width: 940px; }
  .entity-answer h2 { font-size: clamp(2rem, 4vw, 3.25rem); color: var(--color-primary); margin-bottom: 18px; }
  .entity-answer p { font-size: 1.08rem; color: var(--color-muted); line-height: 1.75; }
  .entity-answer a { color: var(--color-primary); font-weight: 800; }
  @media (max-width: 800px) { .entity-answer { padding-bottom: 125px; } }
  @media (max-width: 520px) { .entity-answer { padding: 42px 24px 115px; } }

  .choice { display: flex; justify-content: center; gap: 24px; position: relative; margin-top: -115px; z-index: 2; padding: 0 24px; flex-wrap: wrap; }
  .floating-card { width: 320px; background: #fff; padding: 34px 30px 28px; border-radius: 8px; box-shadow: 0 15px 35px rgba(0,0,0,0.12); text-align: center; }
  .floating-card h3 { color: var(--color-primary); }
  .floating-card p { font-size: 0.9rem; color: var(--color-muted); }

  .leadership { position: relative; margin-top: 85px; padding: 0; background: #f5f6f7; overflow: hidden; }
  .leadership-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: stretch; padding: 0 24px; }
  .leadership-copy { padding: 68px 0; color: var(--color-primary); text-align: left; }
  .leadership-copy h2 { font-size: clamp(2.2rem, 3.5vw, 3.25rem); margin-bottom: 12px; }
  .leadership-copy .role { font-size: 1.2rem; margin-bottom: 30px; color: var(--color-muted); }
  .leadership-copy p:not(.role) { max-width: 640px; font-size: 1.05rem; line-height: 1.6; color: var(--color-ink); }
  .portrait-panel { min-height: 460px; display: flex; align-items: flex-end; justify-content: center; background: linear-gradient(#1d477f 0%, #aebbd0 72%, #f6f6f6 100%); overflow: hidden; }
  .portrait-panel img { display: block; width: 100%; height: 100%; max-height: 460px; object-fit: contain; object-position: center bottom; }
  @media (max-width: 900px) {
    .leadership-grid { grid-template-columns: 1fr; gap: 0; }
    .leadership-copy { padding: 48px 24px; }
  }

  .connected { padding: 85px 0; background: #fff; }
  .connected h2 { font-size: clamp(2.2rem, 4vw, 3.5rem); margin-bottom: 42px; text-align: center; color: var(--color-ink); }
  .connection-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .connection-card { position: relative; min-height: 420px; padding: 38px 28px 42px; border-radius: 11px; box-shadow: 0 7px 22px rgba(0,0,0,0.08); background: #fff; overflow: hidden; }
  .connection-card:after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 18px; }
  .connection-card.owners:after { background: #7ca140; }
  .connection-card.residents:after { background: #ed3c2f; }
  .connection-card.realtors:after { background: #cabe8d; }
  .connection-card.vendors:after { background: #ff681e; }
  .connection-card img { width: 50px; height: 49px; object-fit: contain; margin-bottom: 10px; }
  .connection-card h3 { font-size: 1.4rem; margin: 0 auto 14px; line-height: 1.1; color: var(--color-ink); }
  .connection-card .rule { display: block; width: 105px; border-top: 1px dotted var(--color-primary); margin: 0 auto 18px; }
  .connection-card p { font-size: 0.95rem; line-height: 1.45; margin: 0; color: var(--color-muted); }
  @media (max-width: 900px) { .connection-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .connection-grid { grid-template-columns: 1fr; } }

  .trusted { background: var(--color-bg); padding: 70px 24px; }
  .trusted h2 { text-align: center; color: var(--color-ink); }
  .trusted .intro { max-width: 850px; margin: 0 auto 35px; text-align: center; color: var(--color-muted); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; max-width: 1080px; margin: 0 auto; }
  .stats div { background: var(--color-primary); color: #fff; padding: 28px 10px; border-radius: 16px; text-align: center; }
  .stats strong { display: block; font-size: 2.5rem; }
  .stats strong:after { content: "+"; }
  .stats span { font-size: 0.9rem; }
  @media (max-width: 800px) { .stats { grid-template-columns: 1fr 1fr; } }

  .manage { padding: 80px 24px; }
  .manage h2 { color: var(--color-ink); }
  .service-answer-grid { margin-top: 42px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .service-answer-grid article { padding: 30px; background: #f5f7fb; border-top: 4px solid var(--color-primary); }
  .service-answer-grid h3 { font-size: 1.2rem; color: var(--color-primary); margin-bottom: 10px; }
  .service-answer-grid p { color: var(--color-muted); font-size: 0.95rem; line-height: 1.6; }
  @media (max-width: 900px) { .service-answer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .service-answer-grid { grid-template-columns: 1fr; } }

  .difference { background: #050505; color: #fff; padding: 75px 24px; }
  .difference h2 { color: #fff; }
  .difference .intro { max-width: 750px; margin: 0 auto 40px; opacity: 0.75; }
  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .feature-grid article { background: #fff; color: #333; border-radius: 20px; overflow: hidden; text-align: left; }
  .feature-photo { height: 200px; position: relative; overflow: hidden; }
