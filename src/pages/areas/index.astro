---
// Simple index of every configured service area — only meaningful once site.areas has
// entries; the nav only links here when that's true (see server/methods/website/index.js's
// buildConfigFile in the Aptly monorepo, which conditionally splices this into site.nav).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { site } from '../../config';
---

<BaseLayout
  title={`Service Areas | ${site.companyName}`}
  description={`Cities and neighborhoods served by ${site.companyName}.`}
>
  <Nav homepage={false} activeHref="/areas" />

  <section style="padding:128px 24px 32px;text-align:center;">
    <div class="container" style="max-width:760px;">
      <div class="section-label">Service Areas</div>
      <h1 class="section-title">Where We Manage Properties</h1>
      <p class="section-sub" style="margin:0 auto;">
        {site.companyName} proudly serves the following areas.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:16px;">
    <div class="container">
      {site.areas.length ? (
        <div class="grid-3">
          {site.areas.map(area => (
            <a
              href={`/areas/${area.slug}/`}
              class="card-flat"
              style="display:block;text-decoration:none;color:inherit;"
            >
              <h3 style="font-size:18px;font-weight:700;margin:0 0 8px;">{area.name}</h3>
              {area.access && (
                <p style="font-size:14px;color:var(--color-muted);margin:0;">{area.access}</p>
              )}
            </a>
          ))}
        </div>
      ) : (
        <div class="card-flat" style="text-align:center;padding:48px;">
          <p style="margin:0;color:var(--color-muted);">No service areas have been added yet.</p>
        </div>
      )}
    </div>
  </section>

  <Footer />
</BaseLayout>
